{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@engine/*": ["engine/src/*"],
      "@shared/*": ["shared/*"],
      "@core/*": ["core/*"],
      "react": ["node_modules/@types/react"],
      "react/jsx-runtime": ["node_modules/@types/react/jsx-runtime"],
      "remotion": ["node_modules/remotion"]
    }
  },
  "include": ["shared", "core", "cli", "server", "cloud", "worker", "api", "src", "test", "engine/src", "studio.config.ts", "vite.config.ts", "vitest.config.ts"]
}
