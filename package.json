{
  "name": "reel-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Reel Studio: GUI/CLI that turns raw food-shop footage into 9:16 short reels with telops, AI narration, and captions (Remotion + Claude Code + Fish Audio)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hiromps/reel-studio.git"
  },
  "homepage": "https://github.com/hiromps/reel-studio#readme",
  "bugs": {
    "url": "https://github.com/hiromps/reel-studio/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "reel": "bin/reel"
  },
  "scripts": {
    "reel": "tsx cli/reel.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "server": "tsx server/index.ts",
    "worker": "tsx worker/index.ts",
    "dev": "vite",
    "build": "node scripts/prepare-public.mjs && node scripts/build-api.mjs && vite build",
    "start": "node scripts/launch.mjs",
    "start:dev": "node scripts/launch.mjs --dev",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@remotion/player": "4.0.522",
    "@vercel/blob": "^2.8.0",
    "chokidar": "^4.0.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "jose": "^6.2.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.522",
    "tsx": "^4.19.2",
    "web-push": "^3.6.7",
    "zod": "^3.25.0"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@vercel/node": "^13.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^26.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
